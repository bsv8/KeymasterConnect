{
  "name": "keymaster-connect",
  "version": "0.4.0",
  "description": "Keymaster Connect v1 的独立客户端与接收端协议栈",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv8/KeymasterConnect.git"
  },
  "sideEffects": false,
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "import": "./dist/signing.js",
      "default": "./dist/signing.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js",
      "default": "./dist/script.js"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "prepare": "pnpm run build",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sdk:build": "pnpm run build",
    "sdk:typecheck": "pnpm run typecheck",
    "api:generate": "pnpm --dir doc run api:generate",
    "doc:dev": "pnpm --dir doc run dev",
    "doc:build": "pnpm --dir doc run build",
    "doc:preview": "pnpm --dir doc run preview"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.5.1"
}
